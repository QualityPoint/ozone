{
	"name": "frappe-ui-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --base=/assets/ozone/frontend/ && yarn copy-html-entry",
		"preview": "vite preview",
		"type-check": "node scripts/type-check.mjs",
		"lint": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"copy-html-entry": "cp ../ozone/public/frontend/index.html ../ozone/www/frontend.html"
	},
	"dependencies": {
		"@fontsource/almarai": "^5",
		"@fontsource/montserrat": "^5",
		"@vueuse/core": "^10.11.1",
		"feather-icons": "^4.29.2",
		"frappe-ui": "^0.1.192",
		"vue": "^3.5.13",
		"vue-i18n": "^11",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^22",
		"@vitejs/plugin-vue": "^5.1.4",
		"@vitest/coverage-v8": "^2.1.8",
		"autoprefixer": "^10.4.2",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.5",
		"tailwindcss": "^3.4.15",
		"typescript": "~5.9",
		"vite": "^5.4.10",
		"vitest": "^2.1.8",
		"vue-tsc": "^3"
	}
}
